# ---- Site ----
# Public URL of the site (used in emails/SMS links)
SITE_URL=http://localhost:3000

# ---- Security ----
# Password technicians type to open /tech. Use something long.
TECH_PASSWORD=change-me-to-a-long-passphrase
# Random string used to sign sessions and email confirm links. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-hex-chars

# ---- AI (chat + photo quote) ----
AI_API_KEY=
# Optional: leave empty to use the default model
AI_MODEL=

# ---- Email (https://resend.com, free tier 3,000/month) ----
RESEND_API_KEY=re_...
# Must be a domain you verified in Resend. For testing you can use onboarding@resend.dev
EMAIL_FROM=Glossmith <bookings@yourdomain.ca>
# Where new booking requests go (you)
OWNER_EMAIL=you@example.com

# ---- SMS (https://twilio.com) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Twilio number in E.164, e.g. +15875550123
TWILIO_FROM=+1587...

# ---- Database (https://upstash.com Redis, free tier) ----
# Leave empty for local dev: data is saved to .data/db.json instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
